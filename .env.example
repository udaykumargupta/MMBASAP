# Copy to .env (git-ignored) and fill in. The local server reads it on start.
# With nothing set, MMBASAP runs on this Mac: pair-your-phone works, and the
# owner's Auto SMS is a dry run (printed in the terminal, not sent).

# ---- Storage (Vercel adds these when you connect Neon and Blob — required there)
# DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# BLOB_STORE_ID=store_...         # added on Vercel when you connect the Blob store (OIDC)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...   # alternative (also what the local server uses for Blob)

# ---- Recommended -----------------------------------------------------------
# CRON_SECRET=                    # only Vercel's daily job may run /api/cron/cleanup (open without it)
# PUBLIC_STORAGE_MB=600           # files stored at once by everyone but the owner (0 = no public files)
# PUBLIC_DAILY_DOWNLOAD_MB=300    # file downloads per day

# ---- Optional: the owner's Auto SMS (all three needed to switch it on) --------
# The passcode for the Owner button (6+ characters).
APP_PASSCODE=
# Signs the owner's session. Any random string of 32+ characters:
#   openssl rand -base64 48
JWT_SECRET=
# From the "SMS Gateway for Android" app → Settings → Cloud server (see README).
SMSGATE_USER=
SMSGATE_PASS=
# SMSGATE_SIM=1                   # which SIM sends on a dual-SIM phone
# SMSGATE_DEVICE_ID=              # pin one phone if you connect several
# SMS_PROVIDER=console            # force the dry run
# DAILY_LIMIT=50                  # Auto SMS per day (India time)

# ---- Optional (defaults shown) ---------------------------------------------
# PUBLIC_BASE_URL=https://mmbasap.example.com   # host used in links
# JWT_EXPIRATION_MS=2592000000                  # owner session length: 30 days
# PORT=4190
# LAN_HOST=192.168.1.20                         # let devices on your Wi-Fi reach this Mac (Auto SMS then needs the passcode)
