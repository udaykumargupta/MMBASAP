# Copy to .env (git-ignored) and fill in. The local server reads it on start.
# With nothing set, MMBASAP runs on this Mac with no passcode and prints SMS
# instead of sending them (a dry run) — good for trying it out.

# ---- Sign-in (required on Vercel) ------------------------------------------
# The passcode you type to unlock MMBASAP (6+ characters).
APP_PASSCODE=
# Signs your session tokens. Any random string of 32+ characters:
#   openssl rand -base64 48
JWT_SECRET=

# ---- SMS through your Android phone ----------------------------------------
# From the "SMS Gateway for Android" app → Settings → Cloud Server (see README).
SMSGATE_USER=
SMSGATE_PASS=
# Optional: pin one phone (GET https://api.sms-gate.app/3rdparty/v1/devices lists ids)
# SMSGATE_DEVICE_ID=
# Optional: which SIM sends on a dual-SIM phone (1 or 2)
# SMSGATE_SIM=1
# Force the dry run even when the gateway is configured:
# SMS_PROVIDER=console

# ---- Storage (Vercel adds these when you connect Neon and Blob) -------------
# DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---- Optional (defaults shown) ---------------------------------------------
# PUBLIC_BASE_URL=https://mmbasap.example.com   # host used in SMS links
# DAILY_LIMIT=50                              # SMS per day (India time)
# CRON_SECRET=                                # Vercel sends it to /api/cron/cleanup
# JWT_EXPIRATION_MS=2592000000                # session length: 30 days
# PORT=4190
# LAN_HOST=192.168.1.20                       # let a phone on your Wi-Fi open local share links
